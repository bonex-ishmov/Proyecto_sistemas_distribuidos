# Plantilla. Copiá este archivo a  application-local.properties  (mismo directorio,
# sin el sufijo .example) y completá los valores.
# application-local.properties está en el .gitignore de la raíz: nunca se versiona.
# application.properties lo importa con spring.config.import, así que se lee solo
# (no hace falta activar ningún perfil). Sin este archivo el servicio NO arranca.
#
# La base corre en local, en el contenedor tienda-mysql (docker-compose.yml de la
# raíz, puerto 3307 del host). useSSL=false porque la conexión no sale de la
# máquina; si la base vuelve a un servidor remoto, usar useSSL=true.
# El usuario es 'tienda' y su clave es MYSQL_PASSWORD del archivo .env de la raíz.
#
# ==========================================================================
#  app.jwt.secret DEBE SER BYTE-IDÉNTICO al de ms-identidad, ms-clientes y
#  ms-catalogo. Si difiere aunque sea en UN carácter, un espacio al final o
#  un salto de línea, este servicio devolverá 401 a TODA petición que traiga
#  un token válido emitido por ms-identidad, y el error NO dice "secreto
#  distinto", dice sólo "token inválido". Copialo tal cual de otro módulo,
#  no lo retecleés.
# ==========================================================================

spring.datasource.url=jdbc:mysql://localhost:3307/db_ventas?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.username=tienda
spring.datasource.password=PON_AQUI_MYSQL_PASSWORD_DEL_ENV
app.jwt.secret=PON_AQUI_EL_SECRETO_DE_64_CARACTERES

# ---------- Usuario de sistema (autenticación servicio-a-servicio, Incremento 4) ----------
# ms-ventas hace login con este usuario contra ms-identidad y usa el JWT que
# recibe para llamar a los endpoints /lote de ms-clientes y ms-catalogo.
# Hay que crear este usuario UNA vez en ms-identidad (POST /api/usuarios) y
# excluirlo del listado de usuarios de ms-reportes cuando exista.
# El login es perezoso: si estos valores están mal, ms-ventas arranca igual y
# solo falla (503) al intentar registrar una venta.
ms.identidad.usuario-sistema=PON_AQUI_EL_USUARIO_DE_SISTEMA
ms.identidad.password-sistema=PON_AQUI_LA_CLAVE_DEL_USUARIO_DE_SISTEMA