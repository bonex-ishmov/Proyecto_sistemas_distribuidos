# Plantilla. Copiá este archivo a  application-local.properties  (mismo directorio,
# sin el sufijo .example) y completá los valores.
# application-local.properties está en el .gitignore de la raíz: nunca se versiona.
# application.properties lo importa con spring.config.import, así que se lee solo
# (no hace falta activar ningún perfil). Sin este archivo el servicio NO arranca.
#
# useSSL=true es OBLIGATORIO: la conexión sale a un servidor remoto por internet
# abierto; sin SSL la contraseña y los datos viajan en texto plano.
#
# ==========================================================================
#  app.jwt.secret DEBE SER BYTE-IDÉNTICO al de ms-identidad, ms-clientes y
#  ms-catalogo. Si difiere aunque sea en UN carácter, un espacio al final o
#  un salto de línea, este servicio devolverá 401 a TODA petición que traiga
#  un token válido emitido por ms-identidad, y el error NO dice "secreto
#  distinto", dice sólo "token inválido". Copialo tal cual de otro módulo,
#  no lo retecleés.
# ==========================================================================

