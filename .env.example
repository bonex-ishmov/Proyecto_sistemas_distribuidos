# Plantilla. Copiar a  .env  (misma carpeta, raiz del repo) y poner las claves.
# .env esta en el .gitignore: nunca se versiona. Lo lee docker-compose.yml.

# Clave de root del contenedor MySQL (solo para administrar la base).
MYSQL_ROOT_PASSWORD=PON_AQUI_LA_CLAVE_DE_ROOT

# Clave del usuario 'tienda' (el que usan los microservicios). DEBE coincidir
# con spring.datasource.password del application-local.properties de
# ms-identidad, ms-clientes, ms-catalogo y ms-ventas.
MYSQL_PASSWORD=PON_AQUI_LA_CLAVE_DEL_USUARIO_TIENDA

# Secreto HS256 de los JWT, 64 caracteres. Lo reciben los 10 contenedores de
# los microservicios como APP_JWT_SECRET. Si también corres los servicios con
# ./mvnw, debe ser idéntico al app.jwt.secret de sus application-local.properties.
JWT_SECRET=PON_AQUI_EL_SECRETO_DE_64_CARACTERES

# Usuario de sistema (servicio-a-servicio): ms-identidad lo siembra y ms-ventas
# y ms-reportes hacen login con él.
USUARIO_SISTEMA=ventas-sistema
USUARIO_SISTEMA_PASSWORD=PON_AQUI_LA_CLAVE_DEL_USUARIO_DE_SISTEMA
