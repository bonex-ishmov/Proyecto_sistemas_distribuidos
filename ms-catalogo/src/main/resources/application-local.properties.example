# Plantilla. Copiá este archivo a  application-local.properties  (mismo directorio,
# sin el sufijo .example) y completá los cuatro valores.
# application-local.properties está en el .gitignore de la raíz: nunca se versiona.
# application.properties lo importa con spring.config.import, así que se lee solo
# (no hace falta activar ningún perfil). Sin este archivo el servicio NO arranca.
#
# La base corre en local, en el contenedor tienda-mysql (docker-compose.yml de la
# raíz, puerto 3307 del host). useSSL=false porque la conexión no sale de la
# máquina; si la base vuelve a un servidor remoto, usar useSSL=true.
# El usuario es 'tienda' y su clave es MYSQL_PASSWORD del archivo .env de la raíz.
# app.jwt.secret DEBE ser idéntico en los tres módulos.

spring.datasource.url=jdbc:mysql://localhost:3307/db_catalogo?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.username=tienda
spring.datasource.password=PON_AQUI_MYSQL_PASSWORD_DEL_ENV
app.jwt.secret=PON_AQUI_EL_SECRETO_DE_64_CARACTERES
