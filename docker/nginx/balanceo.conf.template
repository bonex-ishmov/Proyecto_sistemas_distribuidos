# =====================================================================
# docker/nginx/balanceo.conf.template  --  balanceador NGINX
# Una sola plantilla para los 6 NGINX del docker-compose.yml (uno por
# microservicio + el del frontend). Al arrancar, la imagen oficial de nginx
# reemplaza ${REPLICA_1} y ${REPLICA_2} con las variables de entorno del
# contenedor (envsubst) y deja el resultado en /etc/nginx/conf.d/.
# =====================================================================

# Las dos réplicas del servicio. Sin más indicaciones, NGINX reparte las
# peticiones por turnos (round robin). Si una réplica no responde, reintenta
# la petición en la otra (proxy_next_upstream, por defecto "error timeout").
upstream replicas {
    # Memoria compartida entre los procesos trabajadores de NGINX (uno por
    # núcleo). Sin esto, cada trabajador lleva su propio turno del round robin
    # y, como cada conexión cae en un trabajador distinto, casi todas las
    # peticiones empiezan por la réplica 1: el reparto no se ve parejo.
    zone replicas 64k;
    server ${REPLICA_1};
    server ${REPLICA_2};
}

server {
    listen 80;

    # La carga CSV de ms-catalogo admite 2 MB (spring.servlet.multipart);
    # el valor por defecto de NGINX es 1 MB y la cortaría con un 413.
    client_max_body_size 2m;

    location / {
        proxy_pass http://replicas;
        # Conserva el Host original (localhost) a lo largo de la cadena.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Para ver el balanceo: cada respuesta dice qué réplica la atendió.
        add_header X-Atendido-Por $upstream_addr always;
    }
}
